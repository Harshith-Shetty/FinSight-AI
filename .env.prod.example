# FinSight AI - Production Environment Variables

# Database (Neon or Supabase connection string)
DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/dbname

# Redis (Upstash connection string)
REDIS_URL=rediss://default:password@hostname:port

# Qdrant Vector DB (Qdrant Cloud)
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# JWT Auth
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here

# Postmark Email Service
POSTMARK_SERVER_TOKEN=your_postmark_token_here
FRONTEND_URL=https://your-amplify-domain.amplifyapp.com
