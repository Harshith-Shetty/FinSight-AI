# Database Configuration
DATABASE_URL=postgresql+asyncpg://finsight:finsight123@localhost:5432/finsight_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Provider Selection (groq or ollama)
LLM_PROVIDER=groq

# Groq Configuration (for development)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (for production on AWS)
OLLAMA_BASE_URL=http://your-aws-ec2-ip:11434
OLLAMA_MODEL=llama3.2:3b

# Application Settings
APP_NAME=FinSight AI
APP_VERSION=1.0.0
DEBUG=True

# Security
SECRET_KEY=your-secret-key-change-this-in-production
API_KEY_HASH_ALGORITHM=HS256

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Postmark Email Configuration (SMTP)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_MESSAGE_STREAM=outbound


# Update this to use your verified domain address
POSTMARK_FROM_EMAIL=FinSight AI <noreply.finSightAI@harshithshetty.dev>